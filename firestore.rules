rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Jobs collection: anyone can browse jobs, authenticated users can create/update
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isValidId(jobId);
      allow update: if isValidId(jobId);
      allow delete: if isValidId(jobId);
    }

    // Applications collection: candidates submit applications, applicants & employers can read
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if isValidId(applicationId);
      allow update: if isValidId(applicationId);
      allow delete: if isValidId(applicationId);
    }

    // User profiles collection
    match /user_profiles/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }
  }
}
